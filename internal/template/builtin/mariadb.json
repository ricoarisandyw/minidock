{
  "id": "mariadb",
  "name": "MariaDB",
  "icon": "🦭",
  "description": "Community-driven MySQL-compatible database.",
  "image": "mariadb",
  "versions": ["11", "10.11", "10.6"],
  "containerPort": 3306,
  "defaultHostPort": 3307,
  "dataPath": "/var/lib/mysql",
  "fields": [
    { "key": "password", "label": "Root password", "type": "password", "default": "mariadb", "required": true, "minLength": 4 },
    { "key": "database", "label": "Database name", "type": "text", "default": "app", "required": true }
  ],
  "env": {
    "MARIADB_ROOT_PASSWORD": "{{password}}",
    "MARIADB_DATABASE": "{{database}}"
  },
  "connectionString": "mysql://root:{{password}}@{{host}}:{{port}}/{{database}}"
}
